## 6) Makefile Targets (quality-of-life)

```makefile
SHELL := /usr/bin/env bash
.ONESHELL:
.SILENT:

include .env
export

.PHONY: root int crl verify clean

root:
	./bin/ca-init-root.sh

int: root
	./bin/ca-init-int.sh

issue:
	./bin/gen-csr.sh $(CN) $(SAN)
	./bin/ca-issue.sh $(CN) server

revoke:
	./bin/ca-revoke.sh $(CN) $(REASON)

crl:
	./bin/ca-crl.sh

verify:
	./bin/ca-verify.sh $(CN)

clean:
	rm -rf out/issued/$(CN)
```

